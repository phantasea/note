#git/tig 中文乱码问题：
git config --global core.quotepath false

#intall the latest git using apt-get:
sudo add-apt-repository ppa:git-core/ppa
sudo apt-get update
sudo apt-get install git

#install git with source code:
autoconf
./configure --prefix=/usr/local
make
sudo make install

# create a new repo on the command line
git init
git add .
git commit -m "first commit"
git remote add origin https://github.com/phantasea/proj.git
git push -u origin master

#if error reports, edit .git/config file as vifm, then run as below:
git fetch --unshallow origin
git push -u origin master

# add remote repo
git remote add origin git@github.com:phantasea/proj.git

# change git push repo:
git remote set-url --push origin git@github.com:phantasea/proj.git
or
git remote set-url --push origin https://github.com/phantasea/proj.git (but will be asked to enter username and password)

# git tag
git tag -a v-sim1.0 -m "base version tag for sim1"
git push origin v-sim1.0

# git rm but keep file in disk
git rm --cached w3m/bookmark.html

# ! [rejected] master -> master (non-fast-forward)
# error: failed to push some refs to
git push -u origin master --force

# get old version of a file
git checkout <commitID> /path/to/file

# Rewriting the most recent commit message
git commit --amend    (edit in text editor)
git commit --amend -m "New and correct message"

# pull/bring all changes up to <commit-id> to branch master
git checkout master    //skip if current branch is master
git merge <commit-id>

# undo the latest git add into staged
git reset
git restore .

# undo the latest commit
git reset --soft HEAD~1

# undo the git add(unstage)
git reset HEAD /path/to/file

# restore to some specific submit
git reflog
git reset --hard master@{"2 days ago"}
git reset --hard xxxxxxx
git reset --hard tagname

# git merge specific commit
git fetch origin
git merge <full-commit-id>   //all ancester commits before <full-commit-id> will be merged
git cherry-pick <short-commit-id>
git cherry-pick ID_A^..ID_B  //merge commits from ID_A(including) to ID_B

# git pull/checkout the specific commit of given date&time
git checkout 'master@{2018-09-01 01:00:00}'

# remove implicit submodule and add again
git rm --cached path/to/submodule (no trailing slash)
git commit -m "submodule removed"
git add path/to/submodule
git commit -m "path/to/submodule added"

# remove the history from a full clone, and keep the last 50 commits
# where x is the number of the first commit to be kept
# and y is the number of the first commit you want to remove
git rebase --onto commit~y commit~x master
